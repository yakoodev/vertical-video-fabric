{
  "manifest_version": 3,
  "name": "VVF: cookie аккаунтов",
  "short_name": "VVF cookie",
  "version": "1.0.0",
  "description": "Личное расширение: отправляет cookie TikTok и YouTube в свой сервис vertical-video-fabric.",
  "key": "",
  "permissions": ["cookies", "storage"],
  "host_permissions": ["*://*.tiktok.com/*", "*://*.youtube.com/*"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "action": {
    "default_title": "Cookie → сервис",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "vvf-cookies@yakoo.local",
      "strict_min_version": "128.0",
      "data_collection_permissions": { "required": ["authenticationInfo"] }
    }
  }
}
