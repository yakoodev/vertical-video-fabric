DATA_DIR=/data
POSTING_PROXY_URL=
POSTING_PROVIDER_MODE=real
POSTING_AUTH_ENABLED=true
POSTING_API_TOKEN=
WORKER_POLL_SECONDS=2
# Мастер-файл для площадок (app/publish_master.py): auto — чинить только то, что не по
# спецификации (обычный клип — перепаковка с метками BT.709, без потерь); always — всегда
# перекодировать; off — файл клипа как есть.
PUBLISH_MASTER=auto
PUBLISH_MASTER_CRF=17
PUBLISH_MASTER_PRESET=medium
PUBLISH_MASTER_GOP_SEC=0.5
PUBLISH_MASTER_AUDIO_BITRATE=320k
PUBLISH_MASTER_UPSCALE=true
# Повторы шагов загрузки до самого поста (сеть, 429, 5xx); пост не повторяется никогда.
PUBLISH_UPLOAD_RETRIES=2
PUBLISH_UPLOAD_RETRY_SECONDS=5
# UA веб-загрузки TikTok — лучше того браузера, из которого сняты cookie аккаунта (пусто — встроенный).
TIKTOK_USER_AGENT=
# YouTube после загрузки: аудитория (false — «не для детей», true — «для детей», unset — не
# трогать) и категория (id: 20 игры, 24 развлечения, 1 фильмы и анимация; пусто — не трогать).
YOUTUBE_MADE_FOR_KIDS=false
YOUTUBE_CATEGORY_ID=
# Статистика опубликованных клипов (просмотры/лайки): раз в N часов, 0 — только вручную.
STATS_INTERVAL_HOURS=6
STATS_PAUSE_SECONDS=8
EXTERNAL_HTTP_RETRIES=3
EXTERNAL_HTTP_RETRY_SECONDS=2
MAX_UPLOAD_BYTES=1073741824
# Тяжёлые задачи (рендер, Whisper, автофокус) — очередью по столько сразу; 0 — без очереди.
# Кадры для агента (view_frame, contact_sheet) — своей очередью. Память контейнера — 6 ГБ.
HEAVY_JOBS_CONCURRENCY=1
FRAME_JOBS_CONCURRENCY=2

AI_VIDEO_PROVIDER=mock
SUBTITLE_PROVIDER=mock

POLZA_API_KEY=
POLZA_BASE_URL=https://polza.ai/api/v1
POLZA_VIDEO_MODEL=google/gemini-2.5-pro-preview
POLZA_TRANSCRIBE_MODEL=openai/gpt-4o-transcribe
# Озвучка RU переведённых клипов (Polza TTS, ПЛАТНО; docs/guides/translation-dubbing.md).
# Выключена по умолчанию; даже включённая — только с confirm и в пределах бюджета запуска.
DUBBING_ENABLED=0
DUBBING_MAX_BUDGET_RUB=200
POLZA_TTS_MODEL=elevenlabs/eleven-v4
POLZA_TTS_VOICE=brian
# Бесплатная озвучка Gemini TTS по GEMINI_API_KEY (provider gemini; confirm и бюджет не нужны).
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_TTS_VOICE=Kore

GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_VIDEO_MODEL=gemini-3.5-flash
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-flash
# ИИ-монтажёр в редакторе и MCP: самая сильная модель
GEMINI_AGENT_MODEL=gemini-3.1-pro-preview
AGENT_MAX_STEPS=25
GEMINI_TRANSCRIBE_FALLBACK_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite,gemini-flash-lite-latest
GEMINI_FILE_POLL_SECONDS=5
GEMINI_FILE_TIMEOUT_SECONDS=900
GEMINI_HTTP_RETRIES=3
GEMINI_HTTP_RETRY_SECONDS=2
GEMINI_UPLOAD_CHUNK_BYTES=8388608

ARTEMOX_API_KEY=
ARTEMOX_BASE_URL=https://api.artemox.com/v1
ARTEMOX_VIDEO_MODEL=gemini-2.0-flash-lite
ARTEMOX_TRANSCRIBE_MODEL=gemini-2.0-flash-lite
GEMINI_PROXY_URL=
# Прокси для скачивания исходников, если напрямую не выходит (видео-CDN Twitch бывает недоступен).
DOWNLOAD_PROXY_URL=
